# Database/session settings for full-stack apps.
DATABASE_URL=<your-database-url>
JWT_SECRET=<generate-a-long-random-secret>

# Supabase Auth is the default Google sign-in path for Jeriko deployments.
# In Google Cloud, authorize this callback on the OAuth client used by Supabase:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
VITE_APP_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_APP_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<optional-server-admin-key>
